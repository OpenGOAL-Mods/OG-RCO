;;-*-Lisp-*-
(in-package goal)

;; name: mods-rco-tests.gc
;; name in dgo: mods-rco-tests
;; dgos: GAME, ENGINE

(defun rco-reset ()
  (set! (-> *rco-info* task-list-idx) 0)
  (dotimes (i 116)
    (set! (-> *tasks-used* i) #f)
    )
  (dotimes (i 101)
    (set! (-> *rco-info* task-list i) (game-task complete)) ;; just something garbage
    )
  ;; all restrictions OFF
  (set! (-> *rco-settings* no-fcs?) #f)
  (set! (-> *rco-settings* no-lts?) #f)
  (set! (-> *rco-settings* nms-citadel?) #f)
  (set! (-> *rco-settings* no-citadel-hops?) #f)
  (set! (-> *rco-settings* no-tree-hops?) #f)
  (set! (-> *rco-settings* fj-no-early-temple?) #f)
  (set! (-> *rco-settings* fj-no-early-plant-boss?) #f)
  (set! (-> *rco-settings* snowy-no-gate-skip?) #f)
  (set! (-> *rco-settings* snowy-no-fortress-without-flut?) #f)
  (set! (-> *rco-settings* beach-no-early-tower?) #f)
  (set! (-> *rco-settings* mp-no-early-secret-cell?) #f)
  (set! (-> *rco-settings* no-boulder-skip?) #f)
  (set! (-> *rco-settings* no-klaww-skip?) #f)
  (none)
  )

(defun rco-set-task ((game-task-idx game-task) (idx int))
  ;; skips any validation, just for setting up test cases
  (set! (-> *rco-info* task-list idx) game-task-idx)
  (set! (-> *tasks-used* game-task-idx) #t)
  (none)
  )

(defun rco-assert ((name string) (expected symbol) (actual symbol))
  (when (!= actual expected)
    (format #t "ASSERT FAILED: ~S - expected ~A but got ~A~%" name expected actual)
    )
  )

(defun rco-run-tests ()
  ;; test cases to simulate potential scenarios and ensure validations work as intended with restrictions on/off

  ;; already used
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-assert "Not already used" #t (rco-validate-next-task 1 (game-task training-buzzer) 0 #f #f))
  (rco-assert "Already used" #f (rco-validate-next-task 1 (game-task training-gimmie) 0 #f #f))

  ;; require geyser before non-geyser
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-assert "Nothing past Geyser without all 4 Geyser cells" #f (rco-validate-next-task 3 (game-task beach-gimmie) 0 #f #f))
  (rco-set-task (game-task training-door) 3)
  (rco-assert "Past Geyser OK after all 4 Geyser cells" #t (rco-validate-next-task 4 (game-task beach-gimmie) 0 #f #f))

  ;; require oracle/miner cells in order
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-set-task (game-task training-door) 3)
  (rco-assert "V1 Oracle out of order" #f (rco-validate-next-task 4 (game-task village1-oracle-money2) 0 #f #f))
  (rco-set-task (game-task village1-oracle-money1) 4)
  (rco-assert "V1 Oracle in order" #t (rco-validate-next-task 5 (game-task village1-oracle-money2) 0 #f #f))

  (rco-set-task (game-task firecanyon-end) 20)
  (rco-assert "V2 Oracle out of order" #f (rco-validate-next-task 21 (game-task village2-oracle-money2) 0 #f #f))
  (rco-set-task (game-task village2-oracle-money1) 21)
  (rco-assert "V2 Oracle in order" #t (rco-validate-next-task 22 (game-task village2-oracle-money2) 0 #f #f))

  (rco-set-task (game-task ogre-end) 45)
  (rco-assert "V3 Oracle out of order" #f (rco-validate-next-task 46 (game-task village3-oracle-money2) 0 #f #f))
  (rco-set-task (game-task village3-oracle-money1) 46)
  (rco-assert "V3 Oracle in order" #t (rco-validate-next-task 47 (game-task village3-oracle-money2) 0 #f #f))
  
  (rco-assert "Miner 2 before 1" #f (rco-validate-next-task 47 (game-task village3-miner-money2) 0 #f #f))
  (rco-assert "Miner 3 before 1" #f (rco-validate-next-task 47 (game-task village3-miner-money3) 0 #f #f))
  (rco-assert "Miner 4 before 1" #f (rco-validate-next-task 47 (game-task village3-miner-money4) 0 #f #f))
  (rco-set-task (game-task village3-miner-money1) 47)
  (rco-assert "Miner 2 after 1" #t (rco-validate-next-task 48 (game-task village3-miner-money2) 0 #f #f))
  (rco-assert "Miner 3 before 2" #f (rco-validate-next-task 48 (game-task village3-miner-money3) 0 #f #f))
  (rco-assert "Miner 4 before 2" #f (rco-validate-next-task 48 (game-task village3-miner-money4) 0 #f #f))
  (rco-set-task (game-task village3-miner-money2) 48)
  (rco-assert "Miner 3 after 2" #t (rco-validate-next-task 49 (game-task village3-miner-money3) 0 #f #f))
  (rco-assert "Miner 4 before 3" #f (rco-validate-next-task 49 (game-task village3-miner-money4) 0 #f #f))
  (rco-set-task (game-task village3-miner-money3) 49)
  (rco-assert "Miner 4 after 3" #t (rco-validate-next-task 50 (game-task village3-miner-money4) 0 #f #f))

  ;; require FJ fish before misty
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-set-task (game-task training-door) 3)
  (rco-assert "Misty before Fish" #f (rco-validate-next-task 4 (game-task misty-muse) 0 #f #f))
  (rco-set-task (game-task jungle-fishgame) 4)
  (rco-assert "Misty after Fish" #t (rco-validate-next-task 5 (game-task misty-muse) 0 #f #f))

  ;; require end of MP, and any other 2 cells before snowy
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-set-task (game-task training-door) 3)
  (rco-set-task (game-task firecanyon-end) 4)
  (rco-assert "Snowy before end of MP" #f (rco-validate-next-task 5 (game-task snow-ball) 0 #f #f))
  (rco-set-task (game-task ogre-end) 5)
  (rco-assert "Snowy before end of MP + 2 cells (0)" #f (rco-validate-next-task 6 (game-task snow-ball) 0 #f #f))
  (rco-set-task (game-task ogre-buzzer) 6)
  (rco-assert "Snowy before end of MP + 2 cells (1)" #f (rco-validate-next-task 7 (game-task snow-ball) 1 #f #f))
  (rco-set-task (game-task ogre-boss) 7)
  (rco-assert "Snowy before end of MP + 2 cells (2)" #t (rco-validate-next-task 8 (game-task snow-ball) 2 #f #f))

  ;; require purple rings before blue rings
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-set-task (game-task training-door) 3)
  (rco-set-task (game-task firecanyon-end) 4)
  (rco-assert "Blue Rings before Purple Rings" #f (rco-validate-next-task 5 (game-task rolling-ring-chase-2) 0 #f #f))
  (rco-set-task (game-task rolling-ring-chase-1) 5)
  (rco-assert "Blue Rings after Purple Rings" #t (rco-validate-next-task 6 (game-task rolling-ring-chase-2) 0 #f #f))

  ;; No FCS: require 20 cells for end of FC cell
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-set-task (game-task training-door) 3)
  (rco-assert "FCS: allow FC end before 20 cells" #t (rco-validate-next-task 4 (game-task firecanyon-end) 0 #f #f))
  (true! (-> *rco-settings* no-fcs?))
  (rco-assert "No FCS: <20 cells before FC end" #f (rco-validate-next-task 19 (game-task firecanyon-end) 0 #f #f))
  (rco-assert "No FCS: FC end after 20 cells" #t (rco-validate-next-task 20 (game-task firecanyon-end) 0 #f #f))

  ;; require end of FC for anything after FC, including FC flies
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-set-task (game-task training-door) 3)
  (rco-assert "Nothing past FC before FC end" #f (rco-validate-next-task 4 (game-task rolling-ring-chase-1) 0 #f #f))
  (rco-assert "Nothing past FC before FC end (FC flies)" #f (rco-validate-next-task 4 (game-task firecanyon-buzzer) 0 #f #f))
  (rco-set-task (game-task firecanyon-end) 4)
  (rco-assert "FC end before past FC" #t (rco-validate-next-task 5 (game-task rolling-ring-chase-1) 0 #f #f))
  (rco-assert "FC End before past FC (FC flies)" #t (rco-validate-next-task 5 (game-task firecanyon-buzzer) 0 #f #f))

  ;; require end of MP for anything after MP
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-set-task (game-task training-door) 3)
  (rco-set-task (game-task firecanyon-end) 4)
  (rco-assert "Past MP before end of MP" #f (rco-validate-next-task 5 (game-task village3-miner-money1) 0 #f #f))
  (rco-set-task (game-task ogre-end) 5)
  (rco-assert "End of MP before past MP" #t (rco-validate-next-task 6 (game-task village3-miner-money1) 1 #f #f))

  ;; No Stalag/Tree Hops: require end of MP before MP secret cell
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-set-task (game-task training-door) 3)
  (rco-set-task (game-task firecanyon-end) 4)
  (rco-assert "Stalag/Tree Hops: allow MP secret before MP end" #t (rco-validate-next-task 5 (game-task ogre-secret) 0 #f #f))
  (true! (-> *rco-settings* no-tree-hops?))
  (rco-assert "No Stalag/Tree Hops: MP secret before MP end" #f (rco-validate-next-task 5 (game-task ogre-secret) 0 #f #f))
  (rco-set-task (game-task ogre-end) 5)
  (rco-assert "No Stalag/Tree Hops: MP secret after MP end (backwards cell)" #t (rco-validate-next-task 6 (game-task ogre-secret) 1 #f #f))

  ;; No LTS: require 72 cells for lavatube and beyond
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-set-task (game-task training-door) 3)
  (rco-set-task (game-task firecanyon-end) 4)
  (rco-set-task (game-task ogre-end) 5)
  (rco-assert "LTS: allow LT end before 72 cells" #t (rco-validate-next-task 6 (game-task lavatube-end) 0 #f #f))
  (rco-assert "LTS: allow LT flies before 72 cells" #t (rco-validate-next-task 6 (game-task lavatube-buzzer) 0 #f #f))
  (true! (-> *rco-settings* no-lts?))
  (rco-assert "No LTS: <72 cells before LT end" #f (rco-validate-next-task 71 (game-task lavatube-end) 0 #f #f))
  (rco-assert "No LTS: <72 cells before LT flies" #f (rco-validate-next-task 71 (game-task lavatube-buzzer) 0 #f #f))
  (rco-assert "No LTS: LT end after 72 cells" #t (rco-validate-next-task 72 (game-task lavatube-end) 0 #f #f))
  (rco-assert "No LTS: LT flies after 72 cells" #t (rco-validate-next-task 72 (game-task lavatube-buzzer) 0 #f #f))

  ;; No Citadel Skip: require blue+red+yellow sage before green sage or flies
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-set-task (game-task training-door) 3)
  (rco-set-task (game-task firecanyon-end) 4)
  (rco-set-task (game-task ogre-end) 5)
  (rco-set-task (game-task lavatube-end) 6)
  (rco-assert "Citadel Skip: allow Green Sage before RBY" #t (rco-validate-next-task 7 (game-task citadel-sage-green) 0 #f #f))
  (rco-assert "Citadel Skip: allow Citadel flies before RBY" #t (rco-validate-next-task 7 (game-task citadel-buzzer) 0 #f #f))
  (true! (-> *rco-settings* nms-citadel?))
  (rco-assert "No Citadel Skip: missing RBY before Green Sage" #f (rco-validate-next-task 7 (game-task citadel-sage-green) 0 #f #f))
  (rco-assert "No Citadel Skip: missing RBY before Citadel flies" #f (rco-validate-next-task 7 (game-task citadel-buzzer) 0 #f #f))
  (rco-set-task (game-task citadel-sage-red) 7)
  (rco-set-task (game-task citadel-sage-blue) 8)
  (rco-set-task (game-task citadel-sage-yellow) 9)
  (rco-assert "No Citadel Skip: Green Sage after RBY" #t (rco-validate-next-task 10 (game-task citadel-sage-green) 0 #f #f))
  (rco-assert "No Citadel Skip: Citadel flies after RBY" #t (rco-validate-next-task 10 (game-task citadel-buzzer) 0 #f #f))

  ;; No Citadel Hops: require end of LT before citadel
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-set-task (game-task training-door) 3)
  (rco-set-task (game-task firecanyon-end) 4)
  (rco-set-task (game-task ogre-end) 5)
  (rco-assert "Citadel Hops: allow Red Sage before end of LT" #t (rco-validate-next-task 6 (game-task citadel-sage-red) 0 #f #f))
  (rco-assert "Citadel Hops: allow Blue Sage before end of LT" #t (rco-validate-next-task 6 (game-task citadel-sage-blue) 0 #f #f))
  (rco-assert "Citadel Hops: allow Yellow Sage before end of LT" #t (rco-validate-next-task 6 (game-task citadel-sage-yellow) 0 #f #f))
  ;; leave Citadel flies out of this, since it depends on Citadel Skip setting
  (true! (-> *rco-settings* no-citadel-hops?))
  (rco-assert "No Citadel Hops: missing end of LT before Red Sage" #f (rco-validate-next-task 6 (game-task citadel-sage-red) 0 #f #f))
  (rco-assert "No Citadel Hops: missing end of LT before Blue Sage" #f (rco-validate-next-task 6 (game-task citadel-sage-blue) 0 #f #f))
  (rco-assert "No Citadel Hops: missing end of LT before Yellow Sage" #f (rco-validate-next-task 6 (game-task citadel-sage-yellow) 0 #f #f))
  (rco-set-task (game-task lavatube-end) 6)
  (rco-assert "No Citadel Hops: allow Red Sage after end of LT" #t (rco-validate-next-task 7 (game-task citadel-sage-red) 0 #f #f))
  (rco-assert "No Citadel Hops: allow Blue Sage after end of LT" #t (rco-validate-next-task 7 (game-task citadel-sage-blue) 0 #f #f))
  (rco-assert "No Citadel Hops: allow Yellow Sage after end of LT" #t (rco-validate-next-task 7 (game-task citadel-sage-yellow) 0 #f #f))

  ;; No Early Temple: FJ - require top of tower before plant boss and blue switch
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-set-task (game-task training-door) 3)
  (rco-assert "Early Temple: allow plant boss before top of temple" #t (rco-validate-next-task 4 (game-task jungle-plant) 0 #f #f))
  (rco-assert "Early Temple: allow blue switch before top of temple" #t (rco-validate-next-task 4 (game-task jungle-eggtop) 0 #f #f))
  (true! (-> *rco-settings* fj-no-early-temple?))
  (rco-assert "No Early Temple: missing top of temple before plant boss" #f (rco-validate-next-task 4 (game-task jungle-plant) 0 #f #f))
  (rco-assert "No Early Temple: missing top of temple before blue switch" #f (rco-validate-next-task 4 (game-task jungle-eggtop) 0 #f #f))
  (rco-set-task (game-task jungle-tower) 4)
  (rco-assert "No Early Temple: allow plant boss after top of temple" #t (rco-validate-next-task 5 (game-task jungle-plant) 0 #f #f))
  (rco-assert "No Early Temple: allow blue switch after top of temple" #t (rco-validate-next-task 5 (game-task jungle-eggtop) 0 #f #f))

  ;; No Early Plant Boss: FJ - require blue switch before plant boss
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-set-task (game-task training-door) 3)
  (rco-assert "Early Plant Boss: allow plant boss before blue switch" #t (rco-validate-next-task 4 (game-task jungle-plant) 0 #f #f))
  (true! (-> *rco-settings* fj-no-early-plant-boss?))
  (rco-assert "No Early Plant Boss: missing blue switch before plant boss" #f (rco-validate-next-task 4 (game-task jungle-plant) 0 #f #f))
  (rco-set-task (game-task jungle-eggtop) 4)
  (rco-assert "No Early Plant Boss: allow plant boss after blue switch" #t (rco-validate-next-task 5 (game-task jungle-plant) 0 #f #f))

  ;; snowy - require flutflut or yellow switch before frozen crate cell
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-set-task (game-task training-door) 3)
  (rco-set-task (game-task firecanyon-end) 4)
  (rco-set-task (game-task ogre-end) 5)
  (rco-assert "No Frozen crate without flut/yellow switch" #f (rco-validate-next-task 8 (game-task snow-cage) 2 #f #f))
  (rco-set-task (game-task beach-flutflut) 6)
  (rco-assert "Allow Frozen crate after flut" #t (rco-validate-next-task 8 (game-task snow-cage) 2 #f #f))
  ;; reset to test yellow switch instead of flut
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-set-task (game-task training-door) 3)
  (rco-set-task (game-task firecanyon-end) 4)
  (rco-set-task (game-task ogre-end) 5)
  (rco-assert "No Frozen crate without flut/yellow switch" #f (rco-validate-next-task 8 (game-task snow-cage) 2 #f #f))
  (rco-set-task (game-task snow-eggtop) 8)
  (rco-assert "Allow Frozen crate after yellow switch" #t (rco-validate-next-task 9 (game-task snow-cage) 3 #f #f))

  ;; Fort Break-In: snowy - require fortress gate cell before flies and fortress cell
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-set-task (game-task training-door) 3)
  (rco-set-task (game-task firecanyon-end) 4)
  (rco-set-task (game-task ogre-end) 5)
  (rco-assert "Fort Break-In: Allow Snowy Fort before Gate Switch" #t (rco-validate-next-task 8 (game-task snow-fort) 2 #f #f))
  (rco-assert "Fort Break-In: Allow Snowy Flies before Gate Switch" #t (rco-validate-next-task 8 (game-task snow-buzzer) 2 #f #f))
  (true! (-> *rco-settings* snowy-no-gate-skip?))
  (rco-assert "No Fort Break-In: Block Snowy Fort before Gate Switch" #f (rco-validate-next-task 8 (game-task snow-fort) 2 #f #f))
  (rco-assert "No Fort Break-In: Block Snowy Flies before Gate Switch" #f (rco-validate-next-task 8 (game-task snow-buzzer) 2 #f #f))
  (rco-set-task (game-task snow-ball) 8)
  (rco-assert "No Fort Break-In: Allow Snowy Fort after Gate Switch" #t (rco-validate-next-task 9 (game-task snow-fort) 3 #f #f))
  (rco-assert "No Fort Break-In: Allow Snowy Flies after Gate Switch" #t (rco-validate-next-task 9 (game-task snow-buzzer) 3 #f #f))

  ;; Fort Gate Switch Flut Skip: snowy - require flutflut before fort-gate cell
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-set-task (game-task training-door) 3)
  (rco-set-task (game-task firecanyon-end) 4)
  (rco-set-task (game-task ogre-end) 5)
  (rco-assert "Fort Gate Switch Flut Skip: Allow Gate Switch before Flut" #t (rco-validate-next-task 8 (game-task snow-ball) 2 #f #f))
  (true! (-> *rco-settings* snowy-no-fortress-without-flut?))
  (rco-assert "No Fort Gate Switch Flut Skip: Block Gate Switch before Flut" #f (rco-validate-next-task 8 (game-task snow-ball) 2 #f #f))
  (rco-set-task (game-task beach-flutflut) 6)
  (rco-assert "No Fort Gate Switch Flut Skip: Allow Gate Switch after Flut" #t (rco-validate-next-task 8 (game-task snow-ball) 2 #f #f))

  ;; require mirrors before mayor orbs if we've encountered any FJ cells
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-set-task (game-task training-door) 3)
  (rco-assert "No FJ - Allow Mayor Orbs before Mirrors" #t (rco-validate-next-task 4 (game-task village1-mayor-money) 0 #f #f))
  (rco-set-task (game-task jungle-buzzer) 4)
  (rco-assert "Yes FJ - Block Mayor Orbs before Mirrors" #f (rco-validate-next-task 5 (game-task village1-mayor-money) 0 #t #f))
  (rco-set-task (game-task jungle-lurkerm) 5)
  (rco-assert "Yes FJ - Allow Mayor Orbs after Mirrors" #t (rco-validate-next-task 6 (game-task village1-mayor-money) 0 #t #f))

  ;; require moles before geologist orbs if we've encountered any Basin cells
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-set-task (game-task training-door) 3)
  (rco-set-task (game-task firecanyon-end) 4)
  (rco-assert "No Basin - Allow Geologist Orbs before Moles" #t (rco-validate-next-task 5 (game-task village2-geologist-money) 0 #f #f))
  (rco-set-task (game-task rolling-lake) 5)
  (rco-assert "Yes Basin - Block Geologist Orbs before Moles" #f (rco-validate-next-task 6 (game-task village2-geologist-money) 0 #f #t))
  (rco-set-task (game-task rolling-moles) 6)
  (rco-assert "Yes Basin - Allow Geologist Orbs after Moles" #t (rco-validate-next-task 7 (game-task village2-geologist-money) 0 #f #t))

  ;; require DMG before gambler orbs if we've encountered any Basin cells 
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-set-task (game-task training-door) 3)
  (rco-set-task (game-task firecanyon-end) 4)
  (rco-assert "No Basin - Allow Gambler Orbs before DMG" #t (rco-validate-next-task 5 (game-task village2-gambler-money) 0 #f #f))
  (rco-set-task (game-task rolling-lake) 5)
  (rco-assert "Yes Basin - Block Gambler Orbs before DMG" #f (rco-validate-next-task 6 (game-task village2-gambler-money) 0 #f #t))
  (rco-set-task (game-task rolling-race) 6)
  (rco-assert "Yes Basin - Allow Gambler Orbs after DMG" #t (rco-validate-next-task 7 (game-task village2-gambler-money) 0 #f #t))

  ;; No Early Tower: require blue switch before beach tower
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-set-task (game-task training-door) 3)
  (rco-assert "Early Tower: allow tower before blue switch" #t (rco-validate-next-task 4 (game-task beach-cannon) 0 #f #f))
  (true! (-> *rco-settings* beach-no-early-tower?))
  (rco-assert "No Early Tower: block tower before blue switch" #f (rco-validate-next-task 4 (game-task beach-cannon) 0 #f #f))
  (rco-set-task (game-task jungle-eggtop) 4)
  (rco-assert "No Early Tower: allow tower after blue switch" #t (rco-validate-next-task 5 (game-task beach-cannon) 0 #f #f))

  ;; No Backwards Cell: require yellow switch before MP secret cell
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-set-task (game-task training-door) 3)
  (rco-set-task (game-task firecanyon-end) 4)
  (rco-set-task (game-task ogre-end) 5)
  (rco-assert "Backwards Cell: allow backwards cell before yellow switch" #t (rco-validate-next-task 6 (game-task ogre-secret) 0 #f #f))
  (true! (-> *rco-settings* mp-no-early-secret-cell?))
  (rco-assert "No Backwards Cell: block backwards cell before yellow switch" #f (rco-validate-next-task 6 (game-task ogre-secret) 0 #f #f))
  (rco-set-task (game-task snow-eggtop) 8)
  (rco-assert "No Backwards Cell: allow backwards cell after yellow switch" #t (rco-validate-next-task 9 (game-task ogre-secret) 3 #f #f))

  ;; No Boulder Skip: require 45 cells before any MP or beyond cells
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-set-task (game-task training-door) 3)
  (rco-set-task (game-task firecanyon-end) 4)
  (rco-assert "Boulder Skip: allow Klaww before 45 cells" #t (rco-validate-next-task 5 (game-task ogre-boss) 0 #f #f))
  (rco-assert "Boulder Skip: allow MP flies before 45 cells" #t (rco-validate-next-task 5 (game-task ogre-buzzer) 0 #f #f))
  (rco-assert "Boulder Skip: allow MP end before 45 cells" #t (rco-validate-next-task 5 (game-task ogre-end) 0 #f #f))
  (true! (-> *rco-settings* no-boulder-skip?))
  (rco-assert "No Boulder Skip: block Klaww before 45 cells" #f (rco-validate-next-task 5 (game-task ogre-boss) 0 #f #f))
  (rco-assert "No Boulder Skip: block MP flies before 45 cells" #f (rco-validate-next-task 5 (game-task ogre-buzzer) 0 #f #f))
  (rco-assert "No Boulder Skip: block MP end before 45 cells" #f (rco-validate-next-task 5 (game-task ogre-end) 0 #f #f))
  (rco-assert "No Boulder Skip: allow Klaww after 45 cells" #t (rco-validate-next-task 45 (game-task ogre-boss) 0 #f #f))
  (rco-assert "No Boulder Skip: allow MP flies after 45 cells" #t (rco-validate-next-task 45 (game-task ogre-buzzer) 0 #f #f))
  (rco-assert "No Boulder Skip: allow MP end after 45 cells" #t (rco-validate-next-task 45 (game-task ogre-end) 0 #f #f))

  ;; No Klaww Skips: require klaww before anything else in MP or beyond cells
  (rco-reset)
  (rco-set-task (game-task training-gimmie) 0)
  (rco-set-task (game-task training-buzzer) 1)
  (rco-set-task (game-task training-climb) 2)
  (rco-set-task (game-task training-door) 3)
  (rco-set-task (game-task firecanyon-end) 4)
  (rco-assert "Boulder Skip: allow MP flies before Klaww" #t (rco-validate-next-task 5 (game-task ogre-buzzer) 0 #f #f))
  (rco-assert "Boulder Skip: allow MP end before Klaww" #t (rco-validate-next-task 5 (game-task ogre-end) 0 #f #f))
  (true! (-> *rco-settings* no-klaww-skip?))
  (rco-assert "No Boulder Skip: block MP flies before Klaww" #f (rco-validate-next-task 5 (game-task ogre-buzzer) 0 #f #f))
  (rco-assert "No Boulder Skip: block MP end before Klaww" #f (rco-validate-next-task 5 (game-task ogre-end) 0 #f #f))
  (rco-set-task (game-task ogre-boss) 5)
  (rco-assert "No Boulder Skip: allow MP flies after Klaww" #t (rco-validate-next-task 6 (game-task ogre-buzzer) 0 #f #f))
  (rco-assert "No Boulder Skip: allow MP end after Klaww" #t (rco-validate-next-task 6 (game-task ogre-end) 0 #f #f))

  #t
  )