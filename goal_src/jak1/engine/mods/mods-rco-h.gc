;; just to double check I didn't frick either mapping up
(defun check-rco-cell-lists ()
  (dotimes (i 116)
    (when (>= (-> *task-to-cell-lookup* i) 0)
      (when (!= i (-> *cell-list* (-> *task-to-cell-lookup* i)))
        (format 0 "game-task ~D ~S is not mapped correctly!~%" i (game-task->string (the game-task i)))
        (return #f)
        )
      )
    )
  #t
  )